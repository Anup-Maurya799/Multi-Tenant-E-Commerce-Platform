PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/E-commerce

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:5173

# SMTP for verification/reset emails — use Mailtrap.io in dev, real SMTP in prod
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=replace_me
SMTP_PASS=replace_me
EMAIL_FROM="Marketplace <no-reply@zaalima.dev>"
